# Kill switch template
# To enable: copy this file to runtime/.kill
# When .kill exists, this skill runner stops polling immediately.
# It does NOT cancel CLOB orders or flatten/hold positions.
#
# Actions (recorded on the JSON report only):
#   flatten: result=kill_switch_flatten
#   hold: result=kill_switch_hold
# Unknown action values fall back to flatten.
#
# Example:
#   action: flatten
